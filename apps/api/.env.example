# SpotFix Community API — environment variables.
# Copy to `.env` and edit. Production deployments (Oracle Cloud, etc.) should
# inject these via the platform's secret store rather than a file.

# --- HTTP ---
PORT=5001
HOST=0.0.0.0

# --- Database (P2+: Postgres via Prisma) ---
DATABASE_URL=postgresql://spotfix:spotfix@127.0.0.1:5432/spotfix?schema=public

# --- Bootstrap (used by `npm run bootstrap` only) ---
# BOOTSTRAP_TENANT_SLUG=example-campus
# BOOTSTRAP_TENANT_NAME=Example Facilities
# BOOTSTRAP_MASTER_USERNAME=admin
# BOOTSTRAP_MASTER_PASSWORD=change-me
# BOOTSTRAP_MASTER_NAME=Master Admin
# One-time admin promotion helper (`npm run bootstrap:promote-admin`):
# PROMOTE_TENANT_SLUG=example-campus
# PROMOTE_ADMIN_EMAIL=ops@example.com
# PROMOTE_DRY_RUN=true
# When `PROMOTE_ADMIN_EMAIL` is set in the remote deploy environment, `update.sh`
# will trigger this automatically through the `api-bootstrap` compose step.

# --- Mongo→Postgres migration (used by `npm run migrate:mongo` only) ---
# MONGO_URI=mongodb://127.0.0.1:27017/spotfix_community
# TARGET_TENANT_SLUG=example-campus

# --- Auth (JWT) ---
# In production this MUST be a strong random value (>= 64 chars).
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d

# --- Object storage (P3: MinIO locally, OCI Object Storage / S3 in prod) ---
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=spotfix-photos
STORAGE_ACCESS_KEY=spotfix
STORAGE_SECRET_KEY=spotfix-dev-secret
STORAGE_FORCE_PATH_STYLE=true
# Optional: cap presign TTLs (seconds) and per-photo size (bytes).
# STORAGE_PRESIGN_GET_TTL=900
# STORAGE_PRESIGN_PUT_TTL=600
# STORAGE_MAX_UPLOAD_BYTES=10485760

# --- Google Sign-In (P4) ---
# Comma-separated OAuth client IDs trusted as ID-token audience
# (iOS, Android, Web).
GOOGLE_CLIENT_IDS=

# --- CORS (production) ---
# Comma-separated allowlist; "*" is fine for dev only.
# CORS_ALLOWED_ORIGINS=*

# --- Rate limits ---
# Per-IP request caps per 15-minute window. Raise during multi-device demos if needed.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=200

# --- Public domain / OpenAPI server URLs (production) ---
# Set this to your public API host so generated OpenAPI docs advertise full URLs.
# PUBLIC_BASE_URL=http://localhost:5001
# Optional explicit overrides (otherwise derived from PUBLIC_BASE_URL):
# OPENAPI_PRIMARY_SERVER_URL=http://localhost:5001/api/v1
# OPENAPI_DEPRECATED_SERVER_URL=http://localhost:5001/api

# --- Tenant fallback (single-tenant deployments) ---
# Optional: if set, requests without `x-tenant-slug` use this slug.
# DEFAULT_TENANT_SLUG=example-campus
