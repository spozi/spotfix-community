{
  "name": "spotfix-community-api",
  "version": "1.1.0",
  "private": true,
  "description": "API-only backend for SpotFix Community native clients.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx -e \"import('./src/app.ts').then((mod) => { const createApp = mod.createApp ?? mod.default?.createApp; if (typeof createApp !== 'function') { throw new TypeError('createApp export not found'); } const app = createApp(); const s = app.listen(0, () => { console.log('app-ok'); s.close(); }); });\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "bootstrap:promote-admin": "tsx scripts/promote-admin.ts",
    "seed:geo": "tsx scripts/seed-geo.ts",
    "migrate:mongo": "tsx scripts/migrate-mongo-to-postgres.ts",
    "docker:up": "docker compose up --build api",
    "docker:dev": "docker compose --profile dev up --build api-dev",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@aws-sdk/client-s3": "3.1041.0",
    "@aws-sdk/s3-request-presigner": "3.1041.0",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "google-auth-library": "10.6.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pg": "8.20.0",
    "@types/node": "25.6.0",
    "@types/supertest": "7.2.0",
    "mongodb": "7.2.0",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
